# --- Razorpay (TEST MODE keys only — never commit live keys) ---
# Get these from Dashboard > Settings > API Keys, in Test Mode
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Dashboard > Settings > Webhooks > create a webhook pointing at
# https://<your-tunnel-or-host>/api/webhooks/razorpay
# and copy the secret it gives you here
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# --- AI provider (all of these have a FREE tier) ---
# groq      — fastest, best for a demo video  -> https://console.groq.com/keys
# gemini    — Google, generous free tier      -> https://aistudio.google.com/apikey
# openrouter/cerebras                          -> also free tiers
# ollama    — runs locally, needs no key      -> https://ollama.com
# anthropic — paid, highest quality           -> https://console.anthropic.com
LLM_PROVIDER=groq

# Only the key for the provider you selected above is needed.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
ANTHROPIC_API_KEY=

# Optional — override the model. Blank uses the provider's default.
#   groq   -> openai/gpt-oss-120b   (faster alternative: openai/gpt-oss-20b)
#   gemini -> gemini-2.0-flash
# Providers retire models; if you get a 404, list what your key can reach:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
LLM_MODEL=

# --- Mandates (delegated authority for unattended runs) ---
# Signs the spend mandates that bound what the agent may buy when no human is
# watching. If unset, a random per-process secret is used, so mandates stop
# working across a restart — safe, but set this for anything real.
MANDATE_SIGNING_SECRET=change-me-to-a-long-random-string

# --- Guardrails (merchant-side ceiling, applies in BOTH modes) ---
# A buyer's mandate can narrow these, never widen them.
# Hard ceiling on a single order, in INR rupees. The agent cannot create
# a payment link above this amount under any circumstance.
MAX_ORDER_VALUE_INR=50000
# Max quantity of a single line item the agent may add without a human note
MAX_ITEM_QUANTITY=10

# --- Server ---
PORT=4000
CALLBACK_URL=http://localhost:4000/order-confirmed
